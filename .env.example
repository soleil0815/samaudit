# =====================================================================
#  SAMAUDIT – your settings
# =====================================================================
#  Copy once:   cp .env.example .env
#  From then on only edit .env. The .env file belongs to you: it is not
#  part of the download package and is never overwritten by an update.
#
#  Apply changes:   sh update.sh --restart
#  Empty or commented-out lines = default value.
#  Put values containing spaces in quotes.
# =====================================================================

# ---------------- Domain ----------------
# DNS name of the domain – the only required setting
DOMAIN_FQDN=firma.local
# auto = detect Windows AD / Samba AD automatically (windows | samba forces the type)
DOMAIN_TYPE=auto
# optional – without it DOMAIN_FQDN is used (separate several with ;)
#DC_HOSTS=dc01.firma.local;dc02.firma.local

# ---------------- LDAPS ----------------
# LDAPS on port 636
LDAP_SSL=true
# DC certificate:
#   auto   = trust automatically and pin on first contact (default, no CA import needed)
#   trust  = always trust, no check (test environments only)
#   verify = classic validation against a CA file (LDAP_CA_FILE)
LDAP_CERT_MODE=auto
# only for LDAP_CERT_MODE=verify: put the CA file into the certs folder and give its file name
#LDAP_CA_FILE=ca.pem

# ---------------- Access: auditors only, no admins ----------------
# Only members of this group may sign in (name, DN or SID; separate several with ;).
ALLOWED_GROUPS=SAMAUDIT-Benutzer
# Domain/Enterprise/Schema Admins, Administrators, operator groups, DnsAdmins etc.
# are ALWAYS rejected. Further groups that must not get in:
#DENIED_GROUPS=Tier0-Admins

# ---------------- Web interface ----------------
# Port of the web interface (on the server and in the container)
PORT=9400
# HTTPS (self-signed or your own certificate)
TLS_ENABLED=true
# Own certificate: easiest to upload in the web interface under "Connection".
# Alternatively put the file(s) into the certs folder (see certs/README.txt) – only for that:
#TLS_PFX_PASSWORD=password-of-the-pfx-file
#TLS_KEY_PASSWORD=password-of-the-private-key
#TLS_PFX=web.pfx
#TLS_CERT=web.crt
#TLS_KEY=web.key
# Name used to open SAMAUDIT (written into the self-signed certificate;
# with your own certificate SAMAUDIT checks that it is included)
PUBLIC_HOSTNAME=samaudit.firma.local
SESSION_TIMEOUT_MIN=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MIN=15
# de | en
DEFAULT_LANG=de
TZ=Europe/Berlin

# ---------------- Check parameters ----------------
INACTIVE_DAYS=180
ADMIN_INACTIVE_DAYS=90
KRBTGT_MAX_DAYS=180
# SYSVOL/NETLOGON (GPOs, GPP, scripts) via port 445
SMB_CHECKS=true

# ---------------- Network & privacy ----------------
# The program only connects to the DCs (other connections are rejected and logged)
EGRESS_GUARD=true
# optional: further allowed targets (IP, network or name; separate several with ;)
#EGRESS_ALLOW=10.1.2.0/24
# Delete reports automatically after x days (0 = never)
REPORT_RETENTION_DAYS=365
# Delete the activity log (sign-ins, IP addresses) after x days (0 = never)
AUDIT_RETENTION_DAYS=90
# shown on the privacy page
#PRIVACY_CONTACT="IT department, privacy@firma.example"

# ---------------- Docker network (only if needed) ----------------
# If the container cannot resolve the DC names:
#DOCKER_DNS=10.0.0.10;10.0.0.11
#DOCKER_EXTRA_HOSTS=dc01.firma.local:10.0.0.10;dc02.firma.local:10.0.0.11

# ---------------- Updates ----------------
# Image for "sh update.sh --pull" (default: ghcr.io/soleil0815/samaudit, tag latest)
#SAMAUDIT_IMAGE=ghcr.io/soleil0815/samaudit

# ---------------- Other ----------------
# Only for trying it out without a domain (sign in with demo / demo, made-up data)
DEMO_MODE=false
#LOG_LEVEL=INFO
